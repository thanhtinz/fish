<?xml version="1.0" encoding="UTF-8"?>
<module rename-to="html">
    <inherits name="com.badlogic.gdx.backends.gdx_backends_gwt" />
    <inherits name="com.vancan.autofishing.Core" />
    <entry-point class="com.vancan.autofishing.gwt.GwtLauncher" />

    <set-configuration-property name="gdx.assetpath" value="../assets" />
    <set-configuration-property name="xsiframe.failIfScriptTag" value="FALSE" />

    <!-- One permutation instead of one per browser: the game has no browser-specific code and
         a single output halves the compile time and the deployed size. -->
    <set-property name="user.agent" value="safari" />
    <collapse-all-properties />
</module>
