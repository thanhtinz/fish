<?xml version="1.0" encoding="UTF-8"?>
<config>
    <executableName>${app.executable}</executableName>
    <mainClass>com.vancan.autofishing.ios.IOSLauncher</mainClass>
    <os>ios</os>
    <arch>arm64</arch>
    <target>ios</target>
    <iosInfoPList>Info.plist.xml</iosInfoPList>
    <resources>
        <resource>
            <directory>../assets</directory>
            <skipPngCrush>true</skipPngCrush>
        </resource>
    </resources>

    <forceLinkClasses>
        <!-- RoboVM strips unreferenced classes, but libGDX and Objective-C bindings reach some
             of them only from native code, so they have to be linked in explicitly. -->
        <pattern>com.badlogic.gdx.scenes.scene2d.ui.*</pattern>
        <pattern>com.badlogic.gdx.backends.iosrobovm.**</pattern>
        <pattern>com.badlogic.gdx.graphics.g3d.particles.**</pattern>
        <pattern>com.android.okhttp.HttpHandler</pattern>
        <pattern>com.android.okhttp.HttpsHandler</pattern>
        <pattern>com.android.org.conscrypt.**</pattern>
        <pattern>org.apache.harmony.xnet.provider.jsse.**</pattern>
        <pattern>org.apache.harmony.security.provider.cert.**</pattern>
        <pattern>libcore.net.http.**</pattern>
    </forceLinkClasses>

    <libs>
        <lib>z</lib>
    </libs>
    <frameworks>
        <framework>UIKit</framework>
        <framework>OpenGLES</framework>
        <framework>QuartzCore</framework>
        <framework>CoreGraphics</framework>
        <framework>OpenAL</framework>
        <framework>AudioToolbox</framework>
        <framework>AVFoundation</framework>
    </frameworks>
</config>
